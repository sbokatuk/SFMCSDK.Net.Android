<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Which of the package's target frameworks to exercise. Overriding TargetFramework directly on
      the command line breaks restore, so it goes through a property of our own.
    -->
    <SfmcDeviceTargetFramework Condition=" '$(SfmcDeviceTargetFramework)' == '' ">net9.0-android35.0</SfmcDeviceTargetFramework>
    <TargetFramework>$(SfmcDeviceTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>

    <ApplicationId>com.sbokatuk.sfmcsdknet.devicetests</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>

    <!--
      The property, not an @(AndroidManifest) item, and an explicit file rather than none at all.
      The .NET 9 and .NET 10 Android SDKs generate a manifest when the project has no
      $(AndroidManifest); the .NET 8 one defaults the property to the project root and then fails
      with XA1018 because nothing is there. Only surfaces on the net8 leg of the e2e matrix.
    -->
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!--
      No managed trimming and no AOT, in any configuration - and no Java shrinking by default. A
      failure here should only ever mean "the .aar is not in the app", which is the one thing this
      suite is meant to be able to say - with one deliberate exception:
      -p:SfmcDeviceTestsLinkTool=r8 turns Java shrinking ON, and the e2e matrix runs one leg that
      way. The package ships consumer keep-rules under buildTransitive/ (generated by
      build/generate-r8-rules.sh), so a shrunk build is expected to WORK, and a class R8 strips
      because a keep-rule went missing fails functionally here instead of in a consumer's Release
      build.
    -->
    <SfmcDeviceTestsLinkTool Condition=" '$(SfmcDeviceTestsLinkTool)' == '' ">none</SfmcDeviceTestsLinkTool>
    <AndroidLinkTool Condition=" '$(SfmcDeviceTestsLinkTool)' != 'none' ">$(SfmcDeviceTestsLinkTool)</AndroidLinkTool>
    <AndroidLinkTool Condition=" '$(SfmcDeviceTestsLinkTool)' == 'none' "></AndroidLinkTool>
    <AndroidLinkMode>None</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    The e2e deliberately consumes the packed NuGet from ./artifacts rather than a
    ProjectReference, so it exercises the artifact that actually gets published. See NuGet.config
    for the local feed.
  -->
  <PropertyGroup>
    <SfmcPackageVersion Condition=" '$(SfmcPackageVersion)' == '' ">$(VersionPrefix)</SfmcPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SFMCSDK.Net.Android" Version="$(SfmcPackageVersion)" />
  </ItemGroup>

</Project>
