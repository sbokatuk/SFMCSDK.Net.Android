<Project>

  <!--
    Imported into every project that references this package. Only an Android *application* runs
    R8/ProGuard, so that is the only place the rules attach.

    Why they exist: every SFMC SDK entry point in this package is reached from .NET through JNI
    alone - no Java code references it - so a shrinker sees classes nothing uses and removes them
    from a Release build. The failure is then a runtime ClassNotFoundException from a package
    that is, in fact, correctly installed. The .pro alongside is generated by
    build/generate-r8-rules.sh: upstream's own consumer rules, which .NET for Android never reads
    out of the .aar, plus curated keeps for the JNI-only entry surface.
  -->
  <ItemGroup Condition=" '$(AndroidApplication)' == 'true' ">
    <ProguardConfiguration Include="$(MSBuildThisFileDirectory)SFMCSDK.Net.Android.pro" />
  </ItemGroup>

</Project>
