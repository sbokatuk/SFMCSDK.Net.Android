<Project>

  <PropertyGroup>
    <!--
      Package versions are <sfmcsdk version>.<binding revision>, e.g. 3.1.1.1.

      The first three components are the native Salesforce SFMC SDK (com.salesforce.marketingcloud:sfmcsdk)
      inside the package, resolved from Salesforce's own Maven repository. The fourth belongs to
      this repository and increments whenever the bindings or packaging change while the native
      artifact stays put.
    -->
    <SfmcNativeVersion>3.1.1</SfmcNativeVersion>
    <SfmcBindingRevision>1</SfmcBindingRevision>
    <VersionPrefix>$(SfmcNativeVersion).$(SfmcBindingRevision)</VersionPrefix>

    <!--
      common-internal is versioned independently of sfmcsdk upstream (its own line, currently
      1.0.0), declared by the sfmcsdk .pom and shipped inside this package as an unbound .aar -
      see the csproj. One property so a bump is one edit plus a checksum regeneration.
    -->
    <SfmcCommonInternalVersion>1.0.0</SfmcCommonInternalVersion>
  </PropertyGroup>

  <!--
    Versions of the third-party binding packages that supply the Java types sfmcsdk's .aar links
    against, matching the sfmcsdk 3.1.1 .pom exactly:

      kotlin-stdlib 2.2.21, androidx.core:core-ktx 1.17.0, androidx.lifecycle:lifecycle-process
      2.10.0, androidx.annotation 1.9.1, play-services-basement 18.9.0, androidx.work:work-runtime
      2.11.0, androidx.concurrent:concurrent-futures 1.3.0.

    These are NOT the latest stable versions. The current AndroidX and Kotlin bindings have
    dropped net8.0-android34.0 and ship net9/net10 only, so referencing them fails the net8 pass
    with NU1202. Each pin below is the newest NuGet revision that still carries a net8 asset AND
    wraps at least the native version the .pom demands - the same generation the sibling
    MarketingCloudSDK.Net.Android repository pins, because AndroidX must be internally consistent
    or the consuming app fails to dex.
  -->
  <PropertyGroup>
    <KotlinStdLibVersion>2.2.21</KotlinStdLibVersion>
    <AndroidXCoreKtxVersion>1.17.0</AndroidXCoreKtxVersion>
    <AndroidXLifecycleProcessVersion>2.10.0</AndroidXLifecycleProcessVersion>
    <!--
      Lifecycle.Process 2.10.0 - the version the sfmcsdk .pom names - ships net9/net10 assets
      only, so the net8.0-android34.0 head pins the last version that still carries a net8 asset.
      The runtime risk is deliberate and small: sfmcsdk reaches ProcessLifecycleOwner and friends,
      API that has been shape-stable across the 2.x line, and the net9/net10 heads - where Java
      dependency verification actually runs - carry the .pom-exact version.
    -->
    <AndroidXLifecycleProcessVersionNet8>2.9.4</AndroidXLifecycleProcessVersionNet8>
    <AndroidXAnnotationVersion>1.9.1.5</AndroidXAnnotationVersion>
    <GooglePlayServicesBasementVersion>118.9.0</GooglePlayServicesBasementVersion>
    <AndroidXWorkRuntimeVersion>2.11.0</AndroidXWorkRuntimeVersion>
    <!-- 1.3.0.1, not the .pom's bare 1.3.0: Core 1.17.0 floors it there and NU1605 treats the
         resulting downgrade as an error. Same native payload either way. -->
    <AndroidXConcurrentFuturesVersion>1.3.0.1</AndroidXConcurrentFuturesVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>s.bokatuk</Authors>
    <Company>s.bokatuk</Company>
    <Copyright>Copyright © s.bokatuk</Copyright>
    <PackageProjectUrl>https://github.com/sbokatuk/SFMCSDK.Net.Android</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sbokatuk/SFMCSDK.Net.Android</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!--
      One expression for every package: the binding source in this repository is MIT, and the
      native SFMC SDK artifacts built by Salesforce ship under their BSD-3-Clause licence (see
      licenses/ for the texts that are packed).
    -->
    <PackageLicenseExpression>MIT AND BSD-3-Clause</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition=" '$(GITHUB_ACTIONS)' == 'true' ">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Surface the curated release notes on nuget.org. docs/release-notes/<version>.md already feeds
    the GitHub release; packing it here is what makes it reach the .nupkg. A version with no
    curated file - a PR prerelease of unreleased work, typically - falls back to the releases page
    rather than shipping nothing.
  -->
  <PropertyGroup>
    <SfmcReleaseNotesFile>$(MSBuildThisFileDirectory)docs/release-notes/$(VersionPrefix).md</SfmcReleaseNotesFile>
    <PackageReleaseNotes Condition=" Exists('$(SfmcReleaseNotesFile)') ">$([System.IO.File]::ReadAllText('$(SfmcReleaseNotesFile)'))</PackageReleaseNotes>
    <PackageReleaseNotes Condition=" '$(PackageReleaseNotes)' == '' ">https://github.com/sbokatuk/SFMCSDK.Net.Android/releases/tag/v$(VersionPrefix)</PackageReleaseNotes>
  </PropertyGroup>

</Project>
